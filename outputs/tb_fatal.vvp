:vpi_module "C:\iverilog\lib\ivl\v2009.vpi";
S_000001c75b2eed20 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_000001c75b2e1560 .scope module, "tb_fatal" "tb_fatal" 3 3;
 .timescale -9 -12;
    .scope S_000001c75b2e1560;
T_0 ;
    %vpi_call/w 3 5 "$display", "before fatal" {0 0 0};
    %vpi_call/w 3 6 "$fatal", 32'sb00000000000000000000000000000001, "test fatal" {0 0 0};
    %vpi_call/w 3 7 "$display", "after fatal (should not print)" {0 0 0};
    %vpi_call/w 3 8 "$finish" {0 0 0};
    %end;
    .thread T_0;
