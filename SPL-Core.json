{
  "architecture": "SPL-TCU-G1",
  "version": "1.0.0-Commercial",
  "logic_mode": "Second-Perspective",
  "product_class": "Hardware Causal-Audit Trusted Compute Unit (TCU)",
  "_roadmap_commercial_config": {
    "tile_rows": 64,
    "tile_cols": 64,
    "total_tiles": 4096,
    "units_per_tile": 256,
    "total_pim_units": 1048576,
    "total_onchip_sram_bytes": 16777216,
    "peak_performance_tops": 256,
    "clock_frequency_ghz": 1.0
  },
  "interconnect": {
    "type": "2D Mesh NoC",
    "routing": "XY dimension-order",
    "virtual_channels": 2,
    "router_ports": 5
  },
  "host_interface": {
    "type": "PCIe Gen5 x16 / CXL 2.0",
    "bar0_aperture_mb": 256,
    "dma_supported": true,
    "interrupts": true
  },
  "memory_interface": {
    "type": "AXI4",
    "dram_channels": 8,
    "dram_capacity_gb": 64,
    "bandwidth_gbps": 409.6
  },
  "pim_array_per_tile": {
    "rows": 16,
    "cols": 16,
    "total_units": 256,
    "local_storage_per_unit_bits": 128,
    "sram_per_tile_bytes": 4096
  },
  "external_memory": {
    "sram_model_bytes": 16777216,
    "dma_supported": true,
    "axi4_interface": true
  },
  "sequencer": {
    "prog_depth": 1024,
    "return_stack_depth": 8,
    "control_flow_supported": true,
    "distributed_sequencers": true
  },
  "anchor_identity": "0x8525d007_59a4ca22-Universal-Clock-Sync",
  "instructions": [
    {
      "op": "ANCHOR",
      "code": "0x01",
      "desc": "将当前计算状态固化至 State Anchor，不可篡改"
    },
    {
      "op": "EVOLVE",
      "code": "0x02",
      "desc": "在 PIM 单元内就地演化逻辑，禁止数据流出"
    },
    {
      "op": "AUDIT",
      "code": "0x03",
      "desc": "穿透叙事层，强制对账当前的因果权重"
    },
    {
      "op": "STRIP",
      "code": "0x04",
      "desc": "激活 NSM，剥离所有非逻辑相关的输入权重"
    },
    {
      "op": "COMPUTE",
      "code": "0x10",
      "desc": "可信计算原语：ADD/SUB/MUL/CMP/LOGIC 五类操作，产出 P→Q 因果审计对"
    },
    {
      "op": "NS",
      "code": "0x20",
      "desc": "叙事剥离：从输入信号中提取纯逻辑成分"
    },
    {
      "op": "IAP",
      "code": "0x21",
      "desc": "内隐假设检测：验证 P→Q 推理链中未被声明的预设前提"
    },
    {
      "op": "LCH",
      "code": "0x22",
      "desc": "脆弱性对冲：定位逻辑链中最脆弱隐性变量，计算崩塌概率"
    },
    {
      "op": "CCS",
      "code": "0x23",
      "desc": "因果时钟同步：确保分布式审计单元的因果序一致"
    },
    {
      "op": "STATE",
      "code": "0x24",
      "desc": "状态更新：在 PIM 阵列中就地更新并持久化审计状态"
    },
    {
      "op": "JMP",
      "code": "0xF0",
      "desc": "无条件跳转：PC = immediate（控制流指令，不触发PIM计算）"
    },
    {
      "op": "JZ",
      "code": "0xF1",
      "desc": "条件跳转（为零）：pim_flag==1 时 PC = immediate，否则 PC+1"
    },
    {
      "op": "JNZ",
      "code": "0xF2",
      "desc": "条件跳转（非零）：pim_flag==0 时 PC = immediate，否则 PC+1"
    },
    {
      "op": "CALL",
      "code": "0xF3",
      "desc": "子程序调用：压入返回地址(PC+1)至返回栈，PC = immediate"
    },
    {
      "op": "RET",
      "code": "0xF4",
      "desc": "子程序返回：从返回栈弹出返回地址，PC = 弹出值"
    },
    {
      "op": "HALT",
      "code": "0xF5",
      "desc": "终止执行：结束当前序列，跳转到 DONE 状态"
    }
  ]
}
